# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ibl_idea_platform"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-min-32-chars"

# Email (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@iblgroup.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="IBL Excellence Award <noreply@iblgroup.com>"

# File Storage (S3-compatible)
S3_ENDPOINT="https://s3.amazonaws.com"
S3_REGION="us-east-1"
S3_BUCKET="ibl-idea-platform"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AWARD_CONSULTANT_EMAIL="excellenceaward@iblgroup.com"
